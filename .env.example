# =============================================================================
# PROMETHEUS CRM · Variáveis de ambiente
# Copie para .env.local (desenvolvimento) e cadastre as mesmas na Vercel
# (Project › Settings › Environment Variables). Nunca commite .env.local.
# =============================================================================

# --- Supabase (Project Settings › API Keys) ----------------------------------
# URL do projeto
NEXT_PUBLIC_SUPABASE_URL=https://uljyhexcghvfzgobznkt.supabase.co
# Chave PÚBLICA (sb_publishable_...) — pode ir para o navegador
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx
# Chave SECRETA (sb_secret_...) — SOMENTE servidor. Usada pelo link público
# de pré-venda, webhooks da Shopify, API /api/v1 e fila de eventos.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxxxx

# --- URL pública do CRM -------------------------------------------------------
# Usada para montar os links de pré-venda enviados no WhatsApp.
# Ex.: https://crm.suaempresa.com.br  (sem barra no final)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Integrações (opcionais) ----------------------------------------------------
# Chave da API REST /api/v1 (n8n, App próprio). Gere com: openssl rand -hex 32
INTEGRATIONS_API_KEY=
# Segredo das rotinas /api/cron/* — eventos e sincronização do Olist (Vercel Cron envia como Bearer).
# Obrigatório para o Olist ERP. Gere com: openssl rand -hex 32
CRON_SECRET=
# Segredo de assinatura dos webhooks da Shopify (Settings › Notifications › Webhooks)
SHOPIFY_WEBHOOK_SECRET=

# Olist ERP — API v3 (Menu › Configurações › Geral › Aplicativos › + novo aplicativo).
# Permissão: Leitura em Pedidos. URL de redirecionamento: <NEXT_PUBLIC_SITE_URL>/api/olist/callback
OLIST_CLIENT_ID=
OLIST_CLIENT_SECRET=

# WhatsApp da loja — uazapi (painel uazapiGO). Server URL e o token da INSTÂNCIA
# (não o Admin Token). O webhook é ativado pelo botão em Configurações › Integrações.
UAZAPI_URL=https://seu-servidor.uazapi.com
UAZAPI_TOKEN=

# WhatsApp oficial (API Cloud da Meta, Campanhas): o token e os IDs são colados
# pelo admin em Configurações › WhatsApp oficial e ficam no Supabase Vault.
# Os envios usam CRON_SECRET (acima) para chamar a rotina /api/cron/campanhas.
